{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keyhub.local/settings.schema.json",
  "title": "KeyHub Settings",
  "type": "object",
  "required": ["_meta", "preferences", "groups", "usageCache", "audit"],
  "properties": {
    "_meta": {
      "type": "object",
      "required": ["schemaVersion", "createdAt", "updatedAt", "editSequence"],
      "properties": {
        "schemaVersion": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "editSequence": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "preferences": {
      "type": "object",
      "required": ["theme", "showExpiryDaysWarning", "autoRefreshUsage", "keyStorageMode"],
      "properties": {
        "theme": { "type": "string", "enum": ["system", "light", "dark"] },
        "showExpiryDaysWarning": { "type": "integer", "minimum": 0, "maximum": 365 },
        "autoRefreshUsage": { "type": "boolean" },
        "keyStorageMode": { "type": "string", "enum": ["plaintext", "keychain"] }
      },
      "additionalProperties": false
    },
    "groups": {
      "type": "array",
      "items": { "$ref": "#/$defs/group" }
    },
    "usageCache": {
      "type": "object"
    },
    "audit": {
      "type": "object",
      "required": ["lastValidationAt", "lastValidationError"],
      "properties": {
        "lastValidationAt": {
          "anyOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "lastValidationError": {
          "anyOf": [
            { "type": "string" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "group": {
      "type": "object",
      "required": ["id", "name", "children", "items"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/group" }
        },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/item" }
        }
      },
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "required": ["id", "name", "provider", "apiKey", "baseUrl", "models", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "apiKey": { "type": "string", "minLength": 1 },
        "baseUrl": { "type": "string", "format": "uri" },
        "models": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "status": { "type": "string", "enum": ["active", "warning", "expired", "disabled"] },
        "expiresAt": {
          "anyOf": [
            { "type": "string", "format": "date" },
            { "type": "null" }
          ]
        },
        "notes": {
          "anyOf": [
            { "type": "string" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
